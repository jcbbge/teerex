-#!/usr/bin/env python3
-"""agent-ask: put a decision in front of the human, complete, or not at all.
-
-  agent-ask <session> <pane> <from> \
-    --title "Punch list · post()" \
-    --ask "Approve the books step for Nathaniel's punch list?" \
-    --context "What happened and what it means, in plain words." \
-    --option "Go :: what you gain :: what you lose" \
-    --option "Redo with a note :: gain :: lose" \
-    --recommend "Go: because …" \
-    [--answer "go | redo <note>"] [--id ID]
-
-  agent-ask <session> <pane> <from> --resolve ID --answer "what the human said"
-
-The seat's inbox viewer (agent-inbox) pins every open decision at the top as a card and clears it when resolved.
-It refuses a decision missing the ask, the context, two options each with a gain and a loss, or a recommendation:
-the human must be able to decide from the card alone, without hunting through a thread.
-Transport is agent-send, so fenced workers (through the relay) and other machines work the same way.
-"""
-import argparse, json, os, secrets, subprocess, sys
-
-MARK, RESOLVED = "DECISION-JSON:", "DECISION-RESOLVED-JSON:"
-
-def die(msg):
-    sys.stderr.write("agent-ask: " + msg + "\n"); sys.exit(2)
-
-p = argparse.ArgumentParser(add_help=True, description="Put a complete decision in front of the human.")
-p.add_argument("session"); p.add_argument("pane"); p.add_argument("sender")
-p.add_argument("--title"); p.add_argument("--ask"); p.add_argument("--context")
-p.add_argument("--option", action="append", default=[], help='"Label :: what you gain :: what you lose"')
-p.add_argument("--recommend"); p.add_argument("--answer"); p.add_argument("--id")
-p.add_argument("--resolve", metavar="ID")
-a = p.parse_args()
-
-if a.resolve:
-    if not a.answer: die("--resolve needs --answer: what the human decided, in their words")
-    body = RESOLVED + json.dumps({"id": a.resolve, "answer": a.answer})
-else:
-    missing = [f for f in ("title", "ask", "context", "recommend") if not (getattr(a, f) or "").strip()]
-    if missing: die("missing " + ", ".join("--" + m for m in missing) + ". The human decides from the card alone.")
-    opts = []
-    for o in a.option:
-        parts = [x.strip() for x in o.split("::")]
-        if len(parts) != 3 or not all(parts):
-            die(f'--option "{o}" must be "Label :: what you gain :: what you lose", all three filled')
-        opts.append({"label": parts[0], "gain": parts[1], "lose": parts[2]})
-    if len(opts) < 2: die("give at least two --option entries: a choice with one option is not a decision")
-    did = a.id or secrets.token_hex(3)
-    body = MARK + json.dumps({"id": did, "title": a.title, "ask": a.ask, "context": a.context, "options": opts,
-                              "recommend": a.recommend, "answer": a.answer or ""})
-    print(did)
-r = subprocess.run(["agent-send", a.session, a.pane, a.sender, body])
-sys.exit(r.returncode)
