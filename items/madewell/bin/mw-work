#!/usr/bin/env python3
"""The work actor from a shell or a hook. One Rivet actor per thing Josh wants done.

  mw-work new KEY "WHAT" [--effort discovery=low,delivery=medium,...] [--link KEY]...
  mw-work show [KEY] | list
  mw-work event "TEXT" [--kind note] | task "WHAT" | phase PHASE | link KEY
  mw-work check tasks|plan.PHASE ID yes|no "EVIDENCE"
  mw-work done yes|no "EVIDENCE"
  mw-work hook HARNESS        (stdin: the harness's hook event; streams the session into its actor)

KEY defaults to this pane's actor. The engine's admin token is read from ~/madewell/.env in process.
"""
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import urllib.parse
import urllib.request

ENDPOINT = os.environ.get("MW_ENGINE", "http://127.0.0.1:7420")
NAMESPACE = os.environ.get("MW_WORK_NAMESPACE", "madewell-journal")
POOL = os.environ.get("MW_WORK_POOL", "journal")
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "madewell/work"
ITEM = Path(__file__).resolve().parents[1]
PHASES = ("brainstorm", "discovery", "delivery", "land")
DEFAULT_EFFORT = {"brainstorm": "skip", "discovery": "low", "delivery": "low", "land": "low"}


def token():
    env = Path(os.environ.get("MW_ENGINE_ENV", Path.home() / "madewell/.env")).read_text()
    for line in env.splitlines():
        if line.startswith("MADEWELL_ENGINE_ADMIN_TOKEN="):
            return line.split("=", 1)[1].strip()
    raise SystemExit("mw-work: no MADEWELL_ENGINE_ADMIN_TOKEN in ~/madewell/.env")


def call(key, method, route="/", body=None, timeout=10):
    query = urllib.parse.urlencode({"rvt-namespace": NAMESPACE, "rvt-method": "getOrCreate",
                                    "rvt-runner": POOL, "rvt-key": key, "rvt-crash-policy": "sleep"})
    data = None if body is None else (body if isinstance(body, bytes) else json.dumps(body).encode())
    req = urllib.request.Request(f"{ENDPOINT}/gateway/work/request{route}?{query}", data=data, method=method,
                                 headers={"x-rivet-token": token(), "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        raise SystemExit(f"mw-work: {method} {route} for {key}: {e.code} {e.read().decode()[:300]}")


def pane():
    return os.environ.get("AGENT_PANE") or os.environ.get("REX_BLOCK") or os.environ.get("LC_REX_BLOCK")


def pointer():
    block = pane()
    return STATE / "panes" / block.replace(":", "-") if block else None


def current(key=None):
    if key:
        return key
    p = pointer()
    if p and p.exists():
        return p.read_text().strip()
    raise SystemExit("mw-work: this pane has no work actor; mw-work new KEY \"WHAT\"")


def point(key):
    p = pointer()
    if p:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(key + "\n")


def plan_for(effort):
    comps = json.loads((ITEM / "compositions.json").read_text())
    return {ph: [{"id": i + 1, "step": s, "done": None} for i, s in enumerate(comps[ph].get(effort[ph], []))]
            for ph in PHASES}


def who():
    return f"{os.environ.get('MW_HARNESS', 'shell')} {pane() or 'no-pane'}"


def new(key, what, effort=None, links=()):
    eff = dict(DEFAULT_EFFORT, **(effort or {}))
    doc = call(key, "POST", "/", {"what": what, "phase": next(p for p in PHASES if eff[p] != "skip"),
                                  "effort": eff, "plan": plan_for(eff), "links": list(links)})
    point(key)
    call(key, "POST", "/event", {"kind": "created", "who": who(), "text": what})
    return doc


def slug(text):
    words = re.findall(r"[a-z0-9]+", text.lower())[:6]
    return datetime.datetime.now().strftime("%Y%m%d-%H%M") + "-" + ("-".join(words) or "work")


# ---- the hook: stream a harness session into its actor ------------------------------------------

def short(value, n=300):
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    text = " ".join(text.split())
    return text if len(text) <= n else text[:n] + "…"


def actions_since(transcript):
    """Tool calls appended to a Claude or Codex transcript since the last turn."""
    if not transcript or not Path(transcript).exists():
        return []
    mark = STATE / "offsets" / hashlib.sha256(transcript.encode()).hexdigest()
    start = int(mark.read_text()) if mark.exists() else 0
    out = []
    with open(transcript, "rb") as f:
        f.seek(start)
        for raw in f:
            try:
                o = json.loads(raw)
            except ValueError:
                continue
            msg = o.get("message") if isinstance(o.get("message"), dict) else {}
            for part in msg.get("content") or [] if isinstance(msg.get("content"), list) else []:
                if part.get("type") == "tool_use":
                    inp = part.get("input") or {}
                    out.append({"tool": part.get("name"), "what": short(inp.get("description") or inp.get("command")
                                or inp.get("file_path") or inp)})
                elif part.get("type") == "tool_result" and part.get("is_error"):
                    out.append({"tool": "error", "what": short(part.get("content"))})
            pl = o.get("payload") if o.get("type") == "response_item" else None
            if isinstance(pl, dict) and pl.get("type") in ("function_call", "custom_tool_call", "local_shell_call"):
                out.append({"tool": pl.get("name") or pl.get("type"), "what": short(pl.get("arguments") or pl.get("input")
                            or pl.get("action"))})
        end = f.tell()
    mark.parent.mkdir(parents=True, exist_ok=True)
    mark.write_text(str(end))
    return out


def hook(harness):
    event = json.loads(sys.stdin.read() or "{}")
    os.environ["MW_HARNESS"] = harness
    kind = event.get("hook_event_name")
    p = pointer()
    if kind == "UserPromptSubmit":
        prompt = str(event.get("prompt") or "")
        if p and not p.exists() and prompt.strip():
            # Josh opens a session for a scope of work: its first words open the actor.
            new(slug(prompt), short(prompt, 200))
        if p and p.exists():
            call(current(), "POST", "/event", {"kind": "prompt", "who": "operator", "text": short(prompt, 4000)}, 5)
    elif kind in ("Stop", "StopFailure") and p and p.exists():
        transcript = event.get("transcript_path") or event.get("session_file")
        text = event.get("last_assistant_message") or event.get("error") or event.get("message") or ""
        call(current(), "POST", "/event", {"kind": "turn" if kind == "Stop" else "failure", "who": who(),
                                         "text": short(text, 4000) or "(no final text)",
                                         "actions": actions_since(transcript)}, 10)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "hook":
        try:
            hook(rest[0] if rest else "unknown")
        except BaseException as exc:  # a hook never breaks the session
            (STATE / "hook.err").parent.mkdir(parents=True, exist_ok=True)
            with open(STATE / "hook.err", "a") as f:
                f.write(f"{datetime.datetime.now().isoformat()} {exc!r}\n")
        return
    if cmd == "new":
        effort, links, pos = {}, [], []
        it = iter(rest)
        for a in it:
            if a == "--effort":
                effort.update(dict(kv.split("=", 1) for kv in next(it).split(",")))
            elif a == "--link":
                links.append(next(it))
            else:
                pos.append(a)
        out = new(pos[0], pos[1], effort, links)
    elif cmd == "show":
        out = call(current(rest[0] if rest else None), "GET")
    elif cmd == "list":
        req = urllib.request.Request(f"{ENDPOINT}/actors?" + urllib.parse.urlencode(
            {"namespace": NAMESPACE, "name": "work"}), headers={"x-rivet-token": token(),
                                                                "authorization": "Bearer " + token()})
        with urllib.request.urlopen(req, timeout=10) as r:
            actors = json.loads(r.read()).get("actors", [])
        out = [a.get("key") for a in actors]
    elif cmd == "event":
        kind = rest[rest.index("--kind") + 1] if "--kind" in rest else "note"
        out = call(current(), "POST", "/event", {"kind": kind, "who": who(), "text": rest[0]})
    elif cmd == "task":
        out = call(current(), "POST", "/task", {"what": rest[0]})
    elif cmd == "check":
        out = call(current(), "POST", "/check", {"list": rest[0], "id": rest[1], "yes": rest[2] == "yes",
                                               "evidence": rest[3]})
    elif cmd == "phase":
        out = call(current(), "POST", "/", {"phase": rest[0]})
    elif cmd == "link":
        doc = call(current(), "GET")
        out = call(current(), "POST", "/", {"links": sorted(set(doc.get("links") or []) | {rest[0]})})
    elif cmd == "done":
        out = call(current(), "POST", "/", {"done": {"yes": rest[0] == "yes", "evidence": rest[1],
                                                    "at": datetime.datetime.now().astimezone().isoformat()}})
    else:
        raise SystemExit(f"mw-work: unknown command {cmd}")
    print(json.dumps(out, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main(sys.argv[1:])
