#!/usr/bin/env python3
"""Start the Made Well work actor.

  mw-drive KEY
  mw-drive --open KEY

Both forms forward to mw-work go KEY. Read the work and its evidence with mw-work show KEY.
"""
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import mwcartridge

ITEM = Path(__file__).resolve().parents[1]
MW = str(ITEM / "bin/mw-work")


def work(*args):
    if args and args[0] == "event" and args[1].startswith("--kind:"):
        args = ("event", args[2], "--kind", args[1][7:])
    out = subprocess.run([MW, *args], capture_output=True, text=True)
    if out.returncode:
        raise SystemExit(out.stderr.strip() or out.stdout.strip())
    return json.loads(out.stdout)


def now():
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M CT")


def briefing(key, doc, phase, step, who):
    checkpoints = mwcartridge.brief(mwcartridge.load(Path.cwd()), step["step"])
    asks = [e["text"] for e in doc.get("log", []) if e.get("kind") in ("prompt", "created")][:3]
    driver = "your work actor" if os.environ.get("MW_WORK_ATTEMPT") else "mw-drive"
    where = ("hive, without a terminal. Your address is AGENT_PANE=work:" + key
             if os.environ.get("MW_WORK_ATTEMPT") else
             f"hive, in Rex. Your block is REX_SESSION={os.environ.get('REX_SESSION', '?')} "
             f"REX_BLOCK={os.environ.get('REX_BLOCK', '?')}.")
    return f"""You are one hand on a piece of Josh's work. The work is a Rivet actor; you are disposable,
the work is not. Everything you need is in the actor; everything you do goes back into it.

WHO: you are {who['harness']} ({who['model']}, effort {who['effort']}), hired by {driver} for one step.
WHAT: the work "{doc['what']}" (actor key {key}). Your step: {phase}/{step['step']} (id {step['id']}).
  Josh's own words for this work: {json.dumps(asks)}
WHERE: {where} Read `rex __internal skill` before operating Rex.
WHEN: {now()} (write times as CT).
WHY: Made Well's grammar (brainstorm, discovery, delivery, land) drives this work to done yes or no.
  Your step is one function in it: take its input from the actor, return its output to the actor.
HOW:
  - Read the whole work first: {MW} show {key}
  - Log what matters as you go: {MW} event "..." (your turns are also streamed automatically).
  - Add tasks or todos you discover: {MW} task "..." ; later things go in todos.
  - Finish by checking your step with real evidence:
      {MW} check plan.{phase} {step['id']} yes "<what you did and how you know it worked>"
    or, if it cannot be done, {MW} check plan.{phase} {step['id']} no "<why, what you tried, what is needed>".
  - You may delegate. A piece of work you hand off is its own work actor, a child of this one:
      {MW} new <child-key> "<what>" --parent {key} --effort discovery=low,delivery=medium
      {MW} go <child-key>
    Its own work actor drives it. Read its result with {MW} show <child-key>.
    Spawn and talk to agents only through Rex (rex, agent-send) and the actor, never a harness's own
    sub-agents.
  - Stay inside your step. Ask Josh only for a decision only he can make, with agent-ask.
{checkpoints}
"""


def command(who, prompt):
    if who["harness"] == "claude":
        return ["claude", "-p", "--model", who["model"], "--effort", who["effort"],
                "--permission-mode", "bypassPermissions", prompt]
    if who["harness"] == "codex":
        return ["codex", "exec", "-m", who["model"], "-c", f"model_reasoning_effort={who['effort']}",
                "--dangerously-bypass-approvals-and-sandbox", prompt]
    raise ValueError(f"no launcher for harness {who['harness']}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--open":
        argv = argv[1:]
    if len(argv) != 1:
        raise SystemExit("usage: mw-drive [--open] KEY")
    os.execv(MW, [MW, "go", argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
