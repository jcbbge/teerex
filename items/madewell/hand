#!/bin/sh

encode() {
    printf '%s' "$1" | base64 | tr -d '\n'
}

title=$(encode "${MW_CALL-}")
# Rex drops an entire record if the encoded title exceeds its title limit.
title_field=
if [ "${#title}" -le 256 ] && [ -n "$title" ]; then
    title_field=:title=$title
fi

status() {
    message_field=
    if [ "$#" -gt 1 ]; then
        message_field=:msg=$(encode "$2")
    fi
    printf '\033]7501;state=%s:app=madewell%s%s\033\\' "$1" "$title_field" "$message_field"
}
status working
"$@"
code=$?
if [ "$code" -ne 0 ]; then
    status error "Hand exited with code $code"
    exit "$code"
fi
if [ ! -f "${MW_RETURN-}" ]; then
    status error "Hand exited without writing its return file"
    exit 70
fi
status done
