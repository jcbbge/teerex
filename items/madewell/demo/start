#!/bin/sh
# The demo pane. With lua/madewell/actions.lua loaded by the server's init.lua, Made Well asks
# Josh natively (raw input, promotion, what he sees). Without it, Rex cannot show a prompt to a
# `rex do` script, so the raw input is typed here and every todo is promoted.
item=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
while :; do
  run=ping-$(date +%H%M%S)
  if rex actions 2>/dev/null | grep -q '^madewell_ui\b'; then
    printf '\n\033[1mMade Well\033[0m · run %s: answer the question on your Rex app to start (q + Enter here quits)\n' "$run"
    "$item/bin/mw" "$item/demo/josh.lua" run="$run" live=true --json
    IFS= read -r again || exit 0; [ "$again" = q ] && exit 0
  else
    printf '\n\033[1mMade Well\033[0m · type a raw input and press Enter (Enter alone = ping, q = quit): '
    IFS= read -r raw || exit 0
    [ "$raw" = q ] && exit 0
    [ -n "$raw" ] || raw=ping
    inputs=$(printf '%s' "$raw" | python3 -c 'import json,sys; print(json.dumps([sys.stdin.read()]))')
    printf 'run %s: discovery → promote → delivery (a Codex hand answers, a different hand verifies) → shipped\n' "$run"
    "$item/bin/mw" "$item/demo/josh.lua" run="$run" live=true auto=true inputs="$inputs" --json
  fi
done
